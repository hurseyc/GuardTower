[Unit]
Description=GuardTower - fleet manager for AdGuard Home
Documentation=https://github.com/hurseyc/GuardTower
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guardtower
Group=guardtower
Environment=GT_DATA_DIR=/var/lib/guardtower
Environment=GT_LISTEN=:8080
EnvironmentFile=-/etc/default/guardtower
ExecStart=/usr/bin/guardtower serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/guardtower
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
